# Hosted Supabase project credentials.
# Copy this file to .env.local and fill in the values from your project:
#   Supabase Dashboard -> Project Settings -> API
# .env.local is gitignored; this .env.example is committed as the template.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row-Level Security. NEVER expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: set the same strong secret in the Vercel Production environment.
# Vercel Cron calls /api/cron/renewals daily at 00:00 UTC (08:00 Asia/Manila).
# Missing/incorrect authorization fails closed. Cron queues staff tasks/drafts only.
CRON_SECRET=

# Gmail OAuth connection. Reconnect for read permission, then explicitly enable incoming sync.
# All values below are server-only. Register the exact callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_SENDER_EMAIL=admin@pacificinsuranceph.com
# Dedicated random 32-byte key encoded as base64. Retain securely; never reuse other secrets.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_PUBSUB_TOPIC=projects/pacific-insurane-ph/topics/pacific-gmail-inbox
GMAIL_PUBSUB_SUBSCRIPTION=projects/pacific-insurane-ph/subscriptions/pacific-gmail-inbox-push
GMAIL_PUSH_SERVICE_ACCOUNT=pacific-gmail-push@pacific-insurane-ph.iam.gserviceaccount.com
GMAIL_PUSH_AUDIENCE=https://pacific-insurance-ph-ten.vercel.app/api/integrations/gmail/notifications

# Playwright MCP / E2E test login.
# `npm run auth:playwright` provisions this account and saves a signed-in browser
# session to .auth/staff.json, which the Playwright MCP loads (--storage-state) so
# its browser starts already authenticated. See AGENTS.md → "Playwright MCP".
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
PLAYWRIGHT_BASE_URL=http://localhost:3010
