# Hosted Supabase project credentials.
# Copy this file to .env.local and fill in the values from your project:
#   Supabase Dashboard -> Project Settings -> API
# .env.local is gitignored; this .env.example is committed as the template.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row-Level Security. NEVER expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
